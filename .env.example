# Client-side AES encryption key (must match existing encrypted Firestore data)
VITE_SECRET_KEY=

# Telegram Bot configuration (optional defaults; can also be managed in Admin Telegram Center)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_CHAT_ID=

# Optional Firebase Web Config overrides (defaults to project config in src/firebase.ts if unset)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
